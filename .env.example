APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Public resolver cache (Pflichtenheft §3.2.3, P3-T05). A dedicated Redis store
# keeps the resolver hot path under the p95 latency targets. Disable for a cold
# pass-through (e.g. debugging); set the store to `array` where Redis is absent.
RESOLVER_CACHE_ENABLED=true
RESOLVER_CACHE_STORE=resolver
RESOLVER_CACHE_TTL=3600
RESOLVER_CACHE_WARMUP_LIMIT=100
RESOLVER_CACHE_METRICS=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe billing (Pflichtenheft §3.5, P2-T09). Test-mode keys from the Stripe dashboard.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs per plan (test mode).
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Optional overrides for Checkout / Customer Portal return URLs (default: dashboard route).
BILLING_CHECKOUT_SUCCESS_URL=
BILLING_CHECKOUT_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=

# ---------------------------------------------------------------------------
# Backup service (Pflichtenheft §7.2: daily encrypted, 30-day retention,
# external copy, restore tested). See docker-compose.backup.yml and
# docs/operations/backup-restore.md. SECRETS BELOW ARE NEVER COMMITTED —
# fill them only in the runtime secret store / real .env.
# ---------------------------------------------------------------------------
# Rolling retention in days.
BACKUP_RETENTION_DAYS=30
# supercronic schedule (default: daily 02:00, restore test Sun 03:00).
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RESTORE_TEST_SCHEDULE="0 3 * * 0"
# --- SECRET: DB password of the postgres role used for dumps/restores. ---
BACKUP_DB_PASSWORD=
# --- SECRET: GPG symmetric-encryption passphrase. Generate with:
#     openssl rand -base64 32   Store offline too (no passphrase => no restore). ---
BACKUP_ENCRYPTION_PASSPHRASE=
# External S3-compatible target. Leave empty for local-only mode.
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
# --- SECRET: S3 credentials. ---
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Analytics / GeoIP (Pflichtenheft §3.3.1, §3.3.4). Local MaxMind GeoLite2
# database files read from disk — no external HTTP call per scan. Leave empty
# to disable geo enrichment (fields resolve to null).
# ---------------------------------------------------------------------------
GEOIP_CITY_DB=
GEOIP_ASN_DB=
