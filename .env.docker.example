# qrm.sg — Docker Compose Environment
# Copy to .env.docker and fill in real values.
# This file is used by docker-compose.yml; it is NOT the Laravel .env.

# ─── App ───────────────────────────────────────────────
APP_PORT=8080
APP_ENV=production
APP_DEBUG=false
APP_URL=https://qrm.sg
APP_KEY=

# ─── Database ──────────────────────────────────────────
DB_DATABASE=qrm_sg
DB_USERNAME=qrm
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ─── Mail (Resend) ─────────────────────────────────────
MAIL_MAILER=resend
RESEND_API_KEY=

# ─── Stripe ────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
